---
import Stage from '../../layouts/Stage.astro';
import SeamRequest from '../../components/SeamRequest.astro';
import Ecosystem from '../../components/Ecosystem.astro';
import '../../styles/cloud.css';
import { link } from '../../lib/links';
const rows = [
  {
    id: 'where',
    label: 'Where it runs',
    local:
      'Your graphics card, system RAM and CPU, together. Guild plans where each expert lives around the machine it finds.',
    cloud:
      'Machines we would run. You would not need a large graphics card, or any graphics card, on your side.',
  },
  {
    id: 'manage',
    label: 'What you manage',
    local:
      'The install, the model download and the configuration. The installer handles most of it in one command.',
    cloud: 'The aim is nothing to install: a key and an address.',
  },
  {
    id: 'interface',
    label: 'Interface',
    local:
      'OpenAI- and Anthropic-compatible routes, /v1/chat/completions and /v1/messages, on 127.0.0.1:11434.',
    cloud: 'The same routes, so moving between the two is a one-line change.',
  },
  {
    id: 'models',
    label: 'Models',
    local:
      'Qwen3.8 and the other supported Mixture-of-Experts models, from guild pull or your own files.',
    cloud: 'Which models will be offered has not been decided.',
  },
  {
    id: 'status',
    label: 'Where things stand',
    local: 'Available today. Guild is open source under MIT.',
    cloud: 'In development. No endpoints, API keys, pricing, launch dates or service levels yet.',
  },
];
---

<Stage
  property="cloud"
  title="Guild Cloud: hosted Guild, in development"
  description="Guild Cloud is the planned hosted inference platform from The Guild Inference Project, built on the systems work behind Guild. In development; no public endpoints or pricing are available. Guild runs on your own machine today."
  theme="#101214"
>
  <div class="ground" aria-hidden="true">
    <div class="ground__cloud"></div>
  </div>
  <div class="divider" data-divider>
    <p class="divider__tab" aria-hidden="true">
      <span class="divider__l">Your machine</span><span class="divider__r">Guild Cloud</span>
    </p>
    <ol class="divider__ticks" aria-hidden="true">
      {rows.map((r) => <li data-tick={r.id} />)}
    </ol>
  </div>

  <main id="main" class="split">
    <section class="hero" data-sc-act="pin" data-sc-span="1.5">
      <div class="hero__stage" data-sc-stage>
        <div class="hero__ground" aria-hidden="true"></div>
        <a class="hero__mark l" href={link('cloud')}>Guild Cloud</a>
        <a class="hero__home r" href={link('illatio')}>The Guild Inference Project</a>
        <h1 class="hero__title">
          <span class="half l"
            ><span class="half__kick">Available today</span>Run it on your machine.</span
          >
          <span class="half r"
            ><span class="half__kick">In development</span>Or, one day, on ours.</span
          >
        </h1>
        <div class="hero__sub">
          <p class="l">
            Guild serves an OpenAI- and Anthropic-compatible API from your own computer.
          </p>
          <p class="r">
            Guild Cloud is the planned hosted version of the same engine. Nothing is hosted yet.
          </p>
        </div>
        <SeamRequest class="req--hero" />
      </div>
    </section>

    <div class="rows">
      {
        rows.map((r) => (
          <section class="row" id={r.id} data-sc-act="flow" data-row={r.id}>
            <h2 class="row__label">{r.label}</h2>
            <div class="row__side l" data-sc-reveal="right" data-sc-reveal-at="0.12 0.4">
              <p>{r.local}</p>
            </div>
            <div class="row__side r" data-sc-reveal="left" data-sc-reveal-at="0.16 0.44">
              <p>{r.cloud}</p>
            </div>
          </section>
        ))
      }
    </div>

    <section
      class="fold"
      id="today"
      data-sc-act="pin"
      data-sc-span="2.4"
      aria-labelledby="fold-title"
    >
      <div class="fold__stage" data-sc-stage data-fold-stage>
        <div class="fold__ground" aria-hidden="true"></div>
        <p class="fold__strip" aria-hidden="true">Guild Cloud · in development</p>
        <SeamRequest class="req--fold" />
        <div class="fold__copy" data-sc-cue="0.62 1.6 0.25 0.3">
          <h2 id="fold-title">Today, that is your machine.</h2>
          <p>Install Guild, pull a model and serve it. The request above is the one it answers.</p>
          <pre
            class="fold__cmd"
            tabindex="0"
            aria-label="Install and serve commands"><code><span class="mute"># Linux, x86-64</span>
curl -fsSL https://raw.githubusercontent.com/guild-inference/Guild/main/install.sh | bash
guild pull &lt;model&gt;
guild serve &lt;model&gt;</code></pre>
          <p class="fold__actions">
            <a class="cta" href={link('docs', 'serving/')}>Self-host Guild</a>
            <a class="fold__more" href="https://github.com/guild-inference"
              >Follow Guild Cloud on GitHub</a
            >
          </p>
        </div>
        <footer class="fold__foot" data-sc-cue="0.7 1.6 0.25 0.3">
          <Ecosystem />
          <p>
            Guild Cloud is in development. Nothing on this page is a hosted service. The Guild
            Inference Project, {new Date().getUTCFullYear()}.
          </p>
        </footer>
      </div>
    </section>
  </main>

  <script>
    import { actProgress, whileVisible, reduceMotion } from '../../scripts/engine';

    const root = document.documentElement;
    const fold = document.querySelector<HTMLElement>('#today');
    const foldStage = document.querySelector<HTMLElement>('[data-fold-stage]');
    const reqs = [...document.querySelectorAll<HTMLElement>('[data-req]')];
    const narrow = matchMedia('(max-width: 860px)');
    const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - (-2 * t + 2) ** 3 / 2);

    // The divider position, as a fraction of the axis: 0.5 until the fold, then it sweeps until only a
    // strip of the cloud side is left.
    function split(): number {
      if (!fold) return 0.5;
      const p = actProgress(fold);
      const raw = Math.min(1, Math.max(0, (p - 0.14) / 0.5));
      const t = reduceMotion ? (raw > 0.5 ? 1 : 0) : ease(raw);
      root.style.setProperty('--fold-t', t.toFixed(4));
      const axis = narrow.matches ? innerHeight : innerWidth;
      const end = 1 - (narrow.matches ? 40 : 56) / axis;
      return 0.5 + (end - 0.5) * t;
    }

    let last = '';
    function frame() {
      const s = split();
      const key = `${s.toFixed(4)}|${narrow.matches}`;
      if (key !== last) {
        last = key;
        root.style.setProperty('--split', `${(s * 100).toFixed(3)}%`);
        root.style.setProperty('--split-x', `${(innerWidth * s).toFixed(1)}px`);
        foldStage?.setAttribute('data-sc-verify-state', s.toFixed(3));
      }
      // The request blocks move while their stages slide in and out, so their cut is measured every
      // frame they are on screen.
      for (const r of reqs) {
        const box = r.getBoundingClientRect();
        if (box.bottom < 0 || box.top > innerHeight) continue;
        if (narrow.matches) {
          const host = r.closest<HTMLElement>('[data-sc-stage]')!.getBoundingClientRect();
          r.style.setProperty('--cut', `${(host.top + host.height * s - box.top).toFixed(1)}px`);
        } else r.style.setProperty('--cut', `${(innerWidth * s - box.left).toFixed(1)}px`);
      }
    }
    if (fold) whileVisible(fold, frame);
    const hero = document.querySelector('.hero');
    if (hero) whileVisible(hero, frame);
    addEventListener('resize', () => {
      last = '';
      frame();
    });
    frame();

    // The divider's ticks follow the comparison rows.
    const ticks = new Map(
      [...document.querySelectorAll<HTMLElement>('[data-tick]')].map((t) => [t.dataset.tick, t]),
    );
    const rowObserver = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          const id = (e.target as HTMLElement).dataset.row;
          ticks.forEach((t, k) => t.classList.toggle('is-now', k === id));
        }
      },
      { rootMargin: '-45% 0px -45% 0px' },
    );
    document.querySelectorAll('[data-row]').forEach((r) => rowObserver.observe(r));
  </script>
</Stage>
