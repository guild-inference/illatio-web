---
import Stage from '../layouts/Stage.astro';
import ExpertField from '../components/ExpertField.astro';
import Ecosystem from '../components/Ecosystem.astro';
import '../styles/home.css';
import { link } from '../lib/links';
const sentence = ['Make', 'more', 'of', 'the', 'hardware', 'we', 'have.'];
---

<Stage
  title="The Guild Inference Project: intelligence, within reach"
  description="Open inference systems, efficient model research, and a planned cloud platform. The Guild Inference Project builds AI infrastructure around the hardware people already have."
  theme="#0e0e0c"
>
  <main id="main" class="poster">
    <section class="hero" data-sc-act="pin" data-sc-span="1.5" data-sc-drift="#0e0e0c">
      <div class="hero__stage" data-sc-stage>
        <div class="hero__far" aria-hidden="true" data-sc-parallax="-1.7"><span>512</span></div>
        <div class="hero__band" data-sc-parallax="-0.8">
          <ExpertField class="field--band" id="hero-field" />
        </div>
        <header class="mast">
          <a class="mast__mark" href={link('illatio')}>The Guild<br />Inference Project</a>
          <nav class="mast__nav" aria-label="The Guild Inference Project">
            <a href={link('guild')}>Guild</a>
            <a href={link('labs')}>Labs</a>
            <a href={link('cloud')}>Cloud</a>
            <a href={link('docs')}>Docs</a>
            <a href={link('models')}>Models</a>
            <a href="https://github.com/guild-inference">GitHub</a>
          </nav>
        </header>
        <h1 class="hero__title">
          <span class="hero__line">Intelligence,</span>
          <span class="hero__line">within reach<span class="hot">.</span></span>
        </h1>
        <div class="hero__foot">
          <p class="hero__sub">
            Open inference systems and efficient-model research, built around the hardware people
            already own.
          </p>
          <a class="cta" href={link('guild')}>Meet Guild</a>
        </div>
        <p class="hero__caption">
          Each square is one expert. Qwen3.8 sends every word to 10 of its 512.
        </p>
      </div>
    </section>

    <section class="quiet sc-section" data-sc-act="flow" data-sc-drift="#121210">
      <div class="sc-wrap">
        <div class="quiet__text sc-stack" data-sc-in data-sc-stagger="70">
          <p class="quiet__lede">
            Useful intelligence should not depend on owning the newest accelerator.
          </p>
          <p>
            Mixture-of-Experts models hold a great many parameters but use a small share of them for
            each word. That share is where ordinary hardware gets its chance: a graphics card,
            system RAM and a CPU, working on the same model.
          </p>
        </div>
      </div>
    </section>

    <section
      id="sparse"
      class="peak"
      data-sc-act="pin"
      data-sc-span="3.4"
      data-sc-drift="#080807"
      aria-labelledby="peak-title"
    >
      <div class="peak__stage" data-sc-stage data-peak-stage>
        <div class="peak__side">
          <h2 id="peak-title" class="peak__title" data-sc-cue="0 2 0.06" data-sc-kinetic="words">
            Ten of 512.
          </h2>
          <div class="peak__beats">
            <p data-sc-cue="0 0.16 0 0.35">
              A dense model wakes every one of these for every word.
            </p>
            <p data-sc-cue="0.13 0.84 0.08 0.1">
              Qwen3.8 has 512 experts in each layer and sends each word to ten of them, plus one
              shared expert.
            </p>
            <p data-sc-cue="0.82 2 0.2">
              Ten at a time is work a graphics card, system RAM and a CPU can share. That is the
              idea Guild is built on.
            </p>
          </div>
          <p class="peak__tokens" aria-hidden="true">
            {sentence.map((w) => <span data-token>{w}</span>)}
          </p>
          <p class="peak__count" aria-hidden="true">
            <span data-touched>0</span> of 512 experts touched
          </p>
          <form class="peak__try" data-try>
            <label for="route-word">Route your own word</label>
            <input
              id="route-word"
              type="text"
              autocomplete="off"
              spellcheck="false"
              maxlength="24"
              placeholder="type a word"
            />
            <p id="route-result" class="peak__result" role="status"></p>
          </form>
        </div>
        <div class="peak__board">
          <ExpertField class="field--peak" id="peak-field" />
          <p class="peak__shared" aria-hidden="true"><i></i> shared expert, always on</p>
          <p class="peak__note">
            Squares are chosen by hashing each word: an illustration of the ratio, not a trained
            router.
          </p>
        </div>
      </div>
    </section>

    <section class="prop prop--guild" data-sc-act="flow" data-sc-drift="#100f0d">
      <div class="sc-wrap prop__grid">
        <div class="prop__word" data-sc-reveal="left" data-sc-reveal-at="0.08 0.4">
          <h2>Guild</h2>
        </div>
        <div class="prop__text sc-stack" data-sc-in data-sc-stagger="60">
          <p class="prop__status">Guild Engine. Open source, MIT. Available today.</p>
          <p>
            A native inference engine for Mixture-of-Experts models. It plans where every expert
            lives, across GPU memory, system RAM and mapped files, around the machine it finds.
          </p>
          <a class="prop__link" href={link('guild')}>Meet Guild <span aria-hidden="true">↗</span></a
          >
        </div>
      </div>
    </section>

    <section class="prop prop--labs" data-sc-act="flow" data-sc-drift="#100f0d">
      <div class="sc-wrap prop__grid">
        <div class="prop__word" data-sc-reveal="right" data-sc-reveal-at="0.08 0.4">
          <h2>Labs</h2>
        </div>
        <div class="prop__text sc-stack" data-sc-in data-sc-stagger="60">
          <p class="prop__status">
            Guild Labs. Research. Eon is a proposal; a grant decision is pending.
          </p>
          <p>
            Questions about efficient models: sparse architectures, ternary weights, and what
            changes when the model is designed for the machine that runs it.
          </p>
          <a class="prop__link" href={link('labs')}
            >Read the Labs notes <span aria-hidden="true">↗</span></a
          >
        </div>
      </div>
    </section>

    <section class="prop prop--cloud" data-sc-act="flow" data-sc-drift="#13120f">
      <div class="sc-wrap prop__grid">
        <div class="prop__word" data-sc-reveal="left" data-sc-reveal-at="0.08 0.4">
          <h2>Cloud</h2>
        </div>
        <div class="prop__text sc-stack" data-sc-in data-sc-stagger="60">
          <p class="prop__status">Guild Cloud. In development. Nothing is hosted yet.</p>
          <p>
            A planned hosted platform that carries Guild's systems work to a managed service, with
            the same interface you can run at home today.
          </p>
          <a class="prop__link" href={link('cloud')}
            >See where Cloud stands <span aria-hidden="true">↗</span></a
          >
        </div>
      </div>
    </section>

    <section class="rules" data-sc-act="pin" data-sc-span="2.3" data-sc-drift="#17140f">
      <div class="rules__stage" data-sc-stage>
        <h2 class="visually-hidden">How we work</h2>
        <div class="rule rule--a" data-sc-cue="0 1.5 0 0.3">
          <p class="rule__big">Measured, not claimed.</p>
          <p class="rule__small">
            A benchmark names its model, quantization, hardware, context and decoding configuration,
            or it is not published.
          </p>
        </div>
        <div class="rule rule--b" data-sc-cue="0.28 1.5 0.12 0.3">
          <p class="rule__big">Open by design.</p>
          <p class="rule__small">
            Guild Core is open source under MIT. Its documentation is pinned to the exact commit it
            describes.
          </p>
        </div>
        <div class="rule rule--c" data-sc-cue="0.58 1.5 0.12 0.3">
          <p class="rule__big">The machine you have.</p>
          <p class="rule__small">
            One graphics card, plenty of system RAM and a CPU are a starting point, not a
            limitation.
          </p>
        </div>
      </div>
    </section>

    <footer class="close" id="start">
      <div class="sc-wrap close__inner">
        <p class="close__lede">
          Start with what exists today: an engine you can read, build and run on your own machine.
        </p>
        <p class="close__links">
          <a class="close__cta" href={link('guild')}>Meet Guild</a>, read the
          <a href={link('docs')}>documentation</a>, browse <a href={link('models')}>models</a>, or
          follow the <a href="https://github.com/guild-inference">source on GitHub</a>.
        </p>
        <figure class="trace">
          <ExpertField class="field--trace" id="trace-field" />
          <figcaption>
            Your trace: <span data-trace-count>0</span> of 512 experts touched by the words you read and
            typed on this page.
          </figcaption>
        </figure>
        <Ecosystem />
        <div class="close__base">
          <span>The Guild Inference Project, {new Date().getUTCFullYear()}</span>
          <span>Under development. Guild Core is open source under MIT.</span>
        </div>
      </div>
    </footer>
  </main>
  <script>
    import { actProgress, whileVisible } from '../scripts/engine';
    import { paint, route, normalize, EXPERTS } from '../scripts/router';

    const cellsOf = (id: string) => [...document.querySelectorAll<HTMLElement>(`#${id} > i`)];

    // Hero: the band routes the headline's own words as the stage settles.
    const hero = document.querySelector<HTMLElement>('.hero');
    const heroCells = cellsOf('hero-field');
    const heroWords = ['intelligence', 'within', 'reach'];
    let heroIdx = -1;
    if (hero) {
      whileVisible(hero, () => {
        const idx = Math.min(
          heroWords.length - 1,
          Math.floor(actProgress(hero) * heroWords.length),
        );
        if (idx === heroIdx) return;
        heroIdx = idx;
        paint(heroCells, route(heroWords[idx]));
      });
    }

    // Peak: dense, then dark, then the sentence routed word by word with a heat trace.
    const peak = document.querySelector<HTMLElement>('#sparse');
    const stage = document.querySelector<HTMLElement>('[data-peak-stage]');
    const cells = cellsOf('peak-field');
    const tokens = [...document.querySelectorAll<HTMLElement>('[data-token]')];
    const touchedOut = document.querySelector<HTMLElement>('[data-touched]');
    const input = document.querySelector<HTMLInputElement>('#route-word');
    const result = document.querySelector<HTMLElement>('#route-result');
    const routes = tokens.map((t) => route(t.textContent || ''));
    const DENSE_END = 0.13;
    const WORDS_START = 0.2;
    const WORDS_END = 0.84;
    let state = '';

    function render(p: number) {
      const typed = normalize(input?.value || '');
      const step =
        p < DENSE_END
          ? -2
          : p < WORDS_START
            ? -1
            : Math.min(
                tokens.length,
                Math.floor(((p - WORDS_START) / (WORDS_END - WORDS_START)) * tokens.length),
              );
      const key = `${step}|${typed}`;
      if (key === state) return;
      state = key;
      stage?.setAttribute('data-sc-verify-state', key);
      stage?.classList.toggle('is-dense', step === -2 && !typed);

      const heat = new Map<number, number>();
      const upto = Math.min(step, tokens.length - 1);
      for (let i = 0; i <= upto; i++)
        for (const e of routes[i]) heat.set(e, (heat.get(e) ?? 0) + 1);
      tokens.forEach((t, i) => {
        t.classList.toggle('is-past', i < step);
        t.classList.toggle('is-now', i === step);
      });
      if (touchedOut) touchedOut.textContent = String(heat.size);

      if (typed) paint(cells, route(typed), heat);
      else if (step === -2)
        paint(
          cells,
          Array.from({ length: EXPERTS }, (_, i) => i),
        );
      else if (step >= 0 && step < tokens.length) paint(cells, routes[step], heat);
      else paint(cells, [], heat);
    }

    // Close: the visitor's own trace, every expert their words reached on this page.
    const traceCells = cellsOf('trace-field');
    const traceCount = document.querySelector<HTMLElement>('[data-trace-count]');
    const trail = new Map<number, number>();
    const seen = new Set<string>();
    function remember(word: string) {
      const w = normalize(word);
      if (!w || seen.has(w)) return;
      seen.add(w);
      for (const e of route(w)) trail.set(e, (trail.get(e) ?? 0) + 1);
      paint(traceCells, [], trail);
      if (traceCount) traceCount.textContent = String(trail.size);
    }
    heroWords.forEach(remember);

    if (peak)
      whileVisible(peak, () => {
        const p = actProgress(peak);
        render(p);
        const read = Math.floor(((p - WORDS_START) / (WORDS_END - WORDS_START)) * tokens.length);
        for (let i = 0; i <= Math.min(read, tokens.length - 1); i++)
          remember(tokens[i].textContent || '');
      });
    let typing = 0;
    input?.addEventListener('input', () => {
      if (peak) render(actProgress(peak));
      const typed = normalize(input.value);
      clearTimeout(typing);
      typing = window.setTimeout(() => remember(typed), 700);
      if (result)
        result.textContent = typed
          ? `“${typed}” goes to experts ${route(typed).join(', ')}, plus the shared expert.`
          : '';
    });
    document.querySelector('[data-try]')?.addEventListener('submit', (e) => e.preventDefault());
  </script>
</Stage>
