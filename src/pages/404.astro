---
import Stage from '../layouts/Stage.astro';
import '../styles/home.css';
import { link } from '../lib/links';
---

<Stage
  title="Page not found: The Guild Inference Project"
  description="Return to The Guild Inference Project."
  theme="#0f1110"
  noindex
>
  <main id="main" class="poster lost">
    <p class="lost__code" aria-hidden="true">404</p>
    <h1 class="lost__title">A path still to be made.</h1>
    <p class="lost__links">
      <a class="close__cta" href={link('illatio')}>Return to The Guild Inference Project</a>, or go
      to the <a href={link('guild')}>engine</a>, the <a href={link('docs')}>docs</a> or
      <a href={link('labs')}>Labs</a>.
    </p>
  </main>
</Stage>
