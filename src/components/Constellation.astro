---
import { link } from '../lib/links';

// The project at a glance: one open systems base, three properties around it, each in its own property colour.
const tones = { guild: '#34d399', labs: '#c084fc', cloud: '#38bdf8', core: '#fbbf24' };
const satellites = [
  {
    key: 'guild',
    name: 'Guild Engine',
    domain: 'guild.illatio.dev',
    status: 'AVAILABLE TODAY',
    verb: 'BUILDS',
    x: 30,
    y: 58,
    route: 'M 278 166 C 236 150 226 92 186 90',
    lx: 222,
    ly: 152,
  },
  {
    key: 'labs',
    name: 'Guild Labs',
    domain: 'labs.illatio.dev',
    status: 'RESEARCH',
    verb: 'STUDIES',
    x: 454,
    y: 58,
    route: 'M 362 166 C 404 150 414 92 454 90',
    lx: 418,
    ly: 152,
  },
  {
    key: 'cloud',
    name: 'Guild Cloud',
    domain: 'cloud.illatio.dev',
    status: 'IN DEVELOPMENT',
    verb: 'SERVES (PLANNED)',
    x: 242,
    y: 288,
    route: 'M 320 236 L 320 288',
    lx: 332,
    ly: 266,
  },
] as const;
const cells = [
  ['Guild Core', 'Open source · MIT', tones.core, link('guild')],
  ['Guild Engine', 'Available today', tones.guild, link('guild')],
  ['Guild Labs', 'Research', tones.labs, link('labs')],
  ['Guild Cloud', 'In development', tones.cloud, link('cloud')],
] as const;
---

<div class="hero-art constellation" data-field-card>
  <div class="console-topbar">
    <span class="console-dots" aria-hidden="true">
      <i></i><i></i><i></i>
    </span>
    <span>THE GUILD INFERENCE PROJECT // ONE BASE, THREE PROPERTIES</span>
    <span style={`color:${tones.core}`}>● OPEN BY DESIGN</span>
  </div>

  <div class="console-body">
    <svg class="field" viewBox="0 34 640 332" role="img" aria-labelledby="constellation-title">
      <title id="constellation-title">
        The Guild Inference Project: the open-source Guild Core at the centre, linked to Guild
        Engine (available today), Guild Labs (research) and Guild Cloud (in development).
      </title>
      <defs>
        <radialGradient id="core-fade" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color={tones.core} stop-opacity=".22"></stop>
          <stop offset="60%" stop-color={tones.core} stop-opacity=".05"></stop>
          <stop offset="100%" stop-color={tones.core} stop-opacity="0"></stop>
        </radialGradient>
        <filter id="constellation-glow" x="-40%" y="-40%" width="180%" height="180%">
          <feGaussianBlur stdDeviation="3.2" result="blur"></feGaussianBlur>
          <feMerge>
            <feMergeNode in="blur"></feMergeNode>
            <feMergeNode in="SourceGraphic"></feMergeNode>
          </feMerge>
        </filter>
      </defs>

      <circle cx="320" cy="190" r="150" fill="url(#core-fade)"></circle>
      <circle
        class="orbit orbit-slow"
        cx="320"
        cy="190"
        r="124"
        fill="none"
        stroke="#1e293b"
        stroke-dasharray="2 7"></circle>
      <circle
        class="orbit orbit-fast"
        cx="320"
        cy="190"
        r="84"
        fill="none"
        stroke="#273449"
        stroke-dasharray="10 14"></circle>

      {
        satellites.map((s) => (
          <g>
            <path d={s.route} fill="none" stroke="#334155" stroke-width="1.4" />
            <path
              class="packet"
              d={s.route}
              pathLength="100"
              fill="none"
              stroke={tones[s.key]}
              stroke-width="2.6"
              stroke-linecap="round"
              filter="url(#constellation-glow)"
              style={`--delay:${s.key === 'guild' ? 0 : s.key === 'labs' ? 0.9 : 1.8}s`}
            />
            <text
              x={s.lx}
              y={s.ly}
              fill="#9ba8bc"
              font-family="monospace"
              font-size="8.5"
              letter-spacing=".08em"
              text-anchor={s.key === 'guild' ? 'end' : 'start'}
            >
              {s.verb}
            </text>
          </g>
        ))
      }

      <g class="core">
        <circle
          class="core-halo"
          cx="320"
          cy="190"
          r="56"
          fill="none"
          stroke={tones.core}
          stroke-opacity=".35"></circle>
        <circle cx="320" cy="190" r="46" fill="#0d1420" stroke={tones.core} stroke-width="1.6"
        ></circle>
        <path
          d="M 320 158 L 338 189 L 302 189 Z"
          fill="none"
          stroke={tones.core}
          stroke-width="1.8"
          stroke-linejoin="round"
          filter="url(#constellation-glow)"></path>
        <text
          x="320"
          y="207"
          fill="#f3f6fa"
          font-family="monospace"
          font-size="9.5"
          font-weight="700"
          text-anchor="middle"
        >
          GUILD CORE
        </text>
        <text
          x="320"
          y="220"
          fill="#9ba8bc"
          font-family="monospace"
          font-size="8"
          text-anchor="middle"
        >
          OPEN SOURCE
        </text>
      </g>

      {
        satellites.map((s) => (
          <g class="satellite">
            <rect
              x={s.x}
              y={s.y}
              width="156"
              height="66"
              rx="10"
              fill="#0d1420"
              stroke={tones[s.key]}
              stroke-opacity=".55"
              stroke-width="1.3"
            />
            <circle
              class="satellite-dot"
              cx={s.x + 16}
              cy={s.y + 20}
              r="3.6"
              fill={tones[s.key]}
              filter="url(#constellation-glow)"
            />
            <text
              x={s.x + 27}
              y={s.y + 24}
              fill="#f3f6fa"
              font-family="sans-serif"
              font-size="12.5"
              font-weight="700"
            >
              {s.name}
            </text>
            <text x={s.x + 13} y={s.y + 42} fill="#9ba8bc" font-family="monospace" font-size="9">
              {s.domain}
            </text>
            <text
              x={s.x + 13}
              y={s.y + 56}
              fill={tones[s.key]}
              font-family="monospace"
              font-size="8.5"
              font-weight="700"
              letter-spacing=".06em"
            >
              {s.status}
            </text>
          </g>
        ))
      }
    </svg>
  </div>

  <div class="console-metrics">
    {
      cells.map(([name, state, tone, href]) => (
        <a class="console-metric-cell constellation-cell" href={href} style={`--tone:${tone}`}>
          <small>
            <span class="tone-dot" aria-hidden="true" />
            {name}
          </small>
          <strong>{state}</strong>
        </a>
      ))
    }
  </div>
  <div class="art-caption">
    <span>One open systems base · three ways forward</span>
    <button type="button" class="pulse-trigger" data-pulse-btn>
      <span class="dot" aria-hidden="true"></span> Trace the stack
    </button>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.constellation[data-field-card]').forEach((card) => {
    const btn = card.querySelector<HTMLButtonElement>('[data-pulse-btn]');
    let timer: number | undefined;
    btn?.addEventListener('click', () => {
      card.classList.add('is-pulsing');
      window.clearTimeout(timer);
      timer = window.setTimeout(() => card.classList.remove('is-pulsing'), 2400);
    });
  });
</script>
