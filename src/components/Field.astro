---
interface Props {
  variant?: 'illatio' | 'labs' | 'cloud' | 'guild';
}
const { variant = 'illatio' } = Astro.props;
const accent =
  variant === 'guild'
    ? '#34d399'
    : variant === 'labs'
      ? '#c084fc'
      : variant === 'cloud'
        ? '#38bdf8'
        : '#fbbf24';
const secondary =
  variant === 'guild'
    ? '#38bdf8'
    : variant === 'labs'
      ? '#fbbf24'
      : variant === 'cloud'
        ? '#60a5fa'
        : '#34d399';
const headerTitle =
  variant === 'labs'
    ? 'GUILD LABS // SPARSE & TERNARY STUDY'
    : variant === 'cloud'
      ? 'THE GUILD INFERENCE PROJECT // CLOUD ARCHITECTURE (IN DEV)'
      : variant === 'guild'
        ? 'GUILD ENGINE // GPU VRAM + HOST RAM MOE PIPELINE'
        : 'THE GUILD INFERENCE PROJECT // HETEROGENEOUS MOE STACK';

const metrics =
  variant === 'labs'
    ? [
        ['Research Target', 'Sparse MoE + Ternary'],
        ['Ideal log2(3)', '1.585 bits/weight'],
        ['Proposed Family', 'Eon (Grant Pending)'],
        ['Systems Base', 'Guild Core v0.x'],
      ]
    : variant === 'cloud'
      ? [
          ['Platform Status', 'In Development'],
          ['Local Engine', 'Available Today'],
          ['Wire Format', 'OpenAI / Anthropic'],
          ['Isolation', 'Session-Scoped'],
        ]
      : [
          ['Ornith 35B W2', '80.08–80.84 tok/s'],
          ['Qwen W2', '34.16–34.49 tok/s'],
          ['Sampled VRAM', '2.60–7.14 GiB (8G GPU)'],
          ['Greedy Parity', '100% Bitwise Exact'],
        ];
---

<div class="hero-art" data-field-card>
  <div class="console-topbar">
    <span class="console-dots" aria-hidden="true">
      <i></i><i></i><i></i>
    </span>
    <span>{headerTitle}</span>
    <span style={`color:${accent}`}>● VERIFIED SNAPSHOT</span>
  </div>

  <div class="console-body">
    <svg class="field" viewBox="0 0 620 350" role="img" aria-labelledby={`field-title-${variant}`}>
      <title id={`field-title-${variant}`}>
        Architecture diagram showing token intake, GPU VRAM dense attention and Gated DeltaNet
        execution, Host RAM routed Mixture-of-Experts dispatch, and speculative verification.
      </title>
      <defs>
        <radialGradient id={`fade-${variant}`} cx="50%" cy="50%" r="55%">
          <stop offset="0%" stop-color={accent} stop-opacity=".18"></stop>
          <stop offset="65%" stop-color={secondary} stop-opacity=".06"></stop>
          <stop offset="100%" stop-color={accent} stop-opacity="0"></stop>
        </radialGradient>
        <filter id={`glow-${variant}`} x="-25%" y="-25%" width="150%" height="150%">
          <feGaussianBlur stdDeviation="3" result="blur"></feGaussianBlur>
          <feMerge>
            <feMergeNode in="blur"></feMergeNode>
            <feMergeNode in="SourceGraphic"></feMergeNode>
          </feMerge>
        </filter>
      </defs>

      <!-- Subtle ambient glow -->
      <rect x="0" y="0" width="620" height="350" fill={`url(#fade-${variant})`}></rect>

      <!-- Background engineering coordinate grid -->
      <g stroke="#1e293b" stroke-width="0.7" opacity="0.65">
        {
          Array.from({ length: 12 }, (_, i) => (
            <line x1={20 + i * 52} y1="16" x2={20 + i * 52} y2="334" />
          ))
        }
        {
          Array.from({ length: 7 }, (_, i) => (
            <line x1="20" y1={22 + i * 50} x2="600" y2={22 + i * 50} />
          ))
        }
      </g>

      <!-- MODULE 1: Token Intake & Drafter -->
      <rect
        x="24"
        y="112"
        width="136"
        height="126"
        rx="10"
        fill="#0d1420"
        stroke="#334155"
        stroke-width="1.2"></rect>
      <text x="38" y="136" fill={accent} font-family="monospace" font-size="9.5" font-weight="700">
        01 // INTAKE & DRAFT
      </text>
      <text
        x="38"
        y="158"
        fill="#f3f6fa"
        font-family="sans-serif"
        font-size="12.5"
        font-weight="700"
      >
        Prompt / Drafter
      </text>
      <text x="38" y="177" fill="#9ba8bc" font-family="monospace" font-size="9.5">
        • Normal (T=1)
      </text>
      <text x="38" y="193" fill="#9ba8bc" font-family="monospace" font-size="9.5">
        • GPU MTP (k=1)
      </text>
      <text x="38" y="209" fill="#9ba8bc" font-family="monospace" font-size="9.5">
        • Lookup / Retr
      </text>

      <!-- MODULE 2A: Tier 1 GPU VRAM Dense Path -->
      <rect
        x="212"
        y="34"
        width="196"
        height="118"
        rx="10"
        fill="#0d1420"
        stroke={accent}
        stroke-width="1.3"></rect>
      <text x="228" y="56" fill={accent} font-family="monospace" font-size="9.5" font-weight="700">
        02A // TIER 1 · GPU VRAM
      </text>
      <text
        x="228"
        y="76"
        fill="#f3f6fa"
        font-family="sans-serif"
        font-size="12.5"
        font-weight="700"
      >
        Dense & Attention State
      </text>
      <text x="228" y="95" fill="#9ba8bc" font-family="monospace" font-size="9.5">
        GQA / QSA + Gated DeltaNet
      </text>
      <text x="228" y="111" fill="#9ba8bc" font-family="monospace" font-size="9.5">
        Shared Expert + Top-K Router
      </text>
      <!-- Mini VRAM utilization bar -->
      <rect x="228" y="123" width="164" height="6" rx="3" fill="#1e293b"></rect>
      <rect x="228" y="123" width="108" height="6" rx="3" fill={accent}></rect>

      <!-- MODULE 2B: Tier 2 Host System RAM Routed Experts -->
      <rect
        x="212"
        y="194"
        width="196"
        height="126"
        rx="10"
        fill="#0d1420"
        stroke={secondary}
        stroke-width="1.3"></rect>
      <text
        x="228"
        y="216"
        fill={secondary}
        font-family="monospace"
        font-size="9.5"
        font-weight="700"
      >
        02B // TIER 2 · SYSTEM RAM
      </text>
      <text
        x="228"
        y="236"
        fill="#f3f6fa"
        font-family="sans-serif"
        font-size="12.5"
        font-weight="700"
      >
        Sparse MoE Expert Pool
      </text>
      <text x="228" y="254" fill="#9ba8bc" font-family="monospace" font-size="9.5">
        8/256 (Ornith) · 10/512 (Qwen)
      </text>
      <!-- Mini 16-expert activity strip inside Module 2B -->
      <g transform="translate(228, 266)">
        {
          Array.from({ length: 16 }, (_, i) => {
            const active = i === 1 || i === 5 || i === 9 || i === 13;
            return (
              <rect
                class={active ? 'signal' : ''}
                x={i * 10.2}
                y="0"
                width="7.5"
                height="16"
                rx="2"
                fill={active ? secondary : '#1e293b'}
                style={`--delay:${(i * 0.12).toFixed(2)}s`}
              />
            );
          })
        }
      </g>
      <text x="228" y="302" fill="#9ba8bc" font-family="monospace" font-size="9">
        GPACK mmap + GEXEC AVX-512/AVX2
      </text>

      <!-- MODULE 3: Target Verifier & Commit -->
      <rect
        x="460"
        y="112"
        width="136"
        height="126"
        rx="10"
        fill="#0d1420"
        stroke="#334155"
        stroke-width="1.2"></rect>
      <text x="474" y="136" fill={accent} font-family="monospace" font-size="9.5" font-weight="700">
        03 // VERIFY & COMMIT
      </text>
      <text
        x="474"
        y="158"
        fill="#f3f6fa"
        font-family="sans-serif"
        font-size="12.5"
        font-weight="700"
      >
        Window Verifier
      </text>
      <text x="474" y="177" fill="#9ba8bc" font-family="monospace" font-size="9.5">
        • Exact Target Dist
      </text>
      <text x="474" y="193" fill="#9ba8bc" font-family="monospace" font-size="9.5">
        • KV / GDN Commit
      </text>
      <text x="474" y="209" fill="#9ba8bc" font-family="monospace" font-size="9.5">
        • Cost min ms/tok
      </text>

      <!-- Active circuit bus routes connecting Module 1 -> 2A/2B -> 3 -->
      <path
        class="route"
        d="M 160 175 L 186 175 L 186 93 L 212 93 M 186 175 L 186 257 L 212 257 M 408 93 L 434 93 L 434 175 L 460 175 M 408 257 L 434 257 L 434 175"
        fill="none"
        stroke={accent}
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
      <path
        class="route-glow"
        d="M 160 175 L 186 175 L 186 93 L 212 93 M 186 175 L 186 257 L 212 257 M 408 93 L 434 93 L 434 175 L 460 175 M 408 257 L 434 257 L 434 175"
        fill="none"
        stroke={secondary}
        stroke-width="3.2"
        stroke-linecap="round"
        stroke-linejoin="round"
        filter={`url(#glow-${variant})`}></path>

      <!-- Junction nodes (exact coordinates on circuit bus) -->
      <circle class="node-halo" cx="186" cy="175" r="8" fill="none" stroke={accent}></circle>
      <circle class="signal" cx="186" cy="175" r="3.8" fill={accent}></circle>
      <circle class="node-halo" cx="434" cy="175" r="8" fill="none" stroke={secondary}></circle>
      <circle class="signal" cx="434" cy="175" r="3.8" fill={secondary}></circle>
    </svg>
  </div>

  <div class="console-metrics">
    {
      metrics.map(([label, val]) => (
        <div class="console-metric-cell">
          <small>{label}</small>
          <strong>{val}</strong>
        </div>
      ))
    }
  </div>

  <div class="art-caption">
    <span>Heterogeneous MoE execution pipeline</span>
    <button type="button" class="pulse-trigger" data-pulse-btn>
      <span class="dot" aria-hidden="true"></span> Send a token pulse
    </button>
    <span>Conceptual diagram · measured metrics above</span>
  </div>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-field-card]').forEach((card) => {
    const btn = card.querySelector<HTMLButtonElement>('[data-pulse-btn]');
    btn?.addEventListener('click', () => {
      card.classList.remove('is-pulsing');
      void card.offsetWidth;
      card.classList.add('is-pulsing');
      setTimeout(() => card.classList.remove('is-pulsing'), 1800);
    });
  });
</script>
