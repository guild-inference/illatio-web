---
interface Props {
  variant?: 'illatio' | 'labs' | 'cloud' | 'guild';
}
const { variant = 'illatio' } = Astro.props;
const isGuild = variant === 'guild';
const color = isGuild
  ? '#cde698'
  : variant === 'labs'
    ? '#71529c'
    : variant === 'cloud'
      ? '#315f91'
      : '#bd482b';
const muted = isGuild ? '#5b7165' : '#9da798';
---

<div class="hero-art">
  <svg class="field" viewBox="0 0 600 560" role="img" aria-labelledby={`field-title-${variant}`}>
    <title id={`field-title-${variant}`}>
      An abstract field of connected points, with a small active path through a larger network.
    </title>
    <defs
      ><radialGradient id={`fade-${variant}`}
        ><stop offset="0%" stop-color={color} stop-opacity=".12"></stop><stop
          offset="100%"
          stop-color={color}
          stop-opacity="0"></stop></radialGradient
      ></defs
    >
    <circle cx="300" cy="270" r="270" fill={`url(#fade-${variant})`}></circle>
    {
      Array.from({ length: 17 }, (_, row) => (
        <path
          d={`M 20 ${150 + row * 14} Q 240 ${-80 + row * 27}, 580 ${150 + row * 17}`}
          fill="none"
          stroke={muted}
          stroke-width=".6"
          opacity=".33"
        />
      ))
    }
    {
      Array.from({ length: 23 }, (_, col) => (
        <path
          d={`M ${20 + col * 25} ${150 - Math.sin((col / 22) * Math.PI) * 90} Q ${40 + col * 23} 290 ${40 + col * 23} ${400 - Math.sin((col / 22) * Math.PI) * 30}`}
          fill="none"
          stroke={muted}
          stroke-width=".6"
          opacity=".33"
        />
      ))
    }
    {
      Array.from({ length: 17 }, (_, row) =>
        Array.from({ length: 23 }, (_, col) => {
          const x = 20 + col * 25;
          const y = 150 + row * 14 - Math.sin((col / 22) * Math.PI) * (90 - row * 4);
          const on =
            (col === 8 && row > 5 && row < 10) ||
            (row === 8 && col > 8 && col < 17) ||
            (col === 16 && row > 7 && row < 14);
          return (
            <circle
              class={on ? 'signal' : ''}
              cx={x}
              cy={y}
              r={on ? 3.6 : 1.35}
              fill={on ? color : muted}
              opacity={on ? 1 : 0.5}
              style={`--delay:${row * 0.025}s`}
            />
          );
        }),
      )
    }
    <path
      class="route"
      d="M220 190 220 218 420 238 420 310"
      fill="none"
      stroke={color}
      stroke-width="1.3"></path>
    <circle cx="220" cy="190" r="11" fill="none" stroke={color}></circle><circle
      cx="420"
      cy="310"
      r="11"
      fill="none"
      stroke={color}></circle>
    <g
      fill={isGuild ? '#b3beb6' : '#5d655e'}
      font-family="monospace"
      font-size="10"
      letter-spacing="1"
      ><text x="25" y="90"
        >{
          variant === 'labs'
            ? 'RESEARCH / OPEN QUESTIONS'
            : variant === 'cloud'
              ? 'LOCAL → HOSTED / IN DEVELOPMENT'
              : 'SPARSE SYSTEMS / ACTIVE PATH'
        }</text
      ><text x="25" y="470">FEWER ACTIVE WEIGHTS.</text><text x="25" y="488"
        >MORE POSSIBILITIES.</text
      ><text x="430" y="488">FIG. 01</text></g
    >
    <path d="M25 510h550" stroke={muted} stroke-width=".5"></path>
    <path d="M25 500v20m550-20v20" stroke={muted}></path>
  </svg>
  <div class="art-caption">
    <span>A study in sparse computation</span><span>Conceptual illustration / not telemetry</span>
  </div>
</div>
