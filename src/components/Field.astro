---
interface Props {
  variant?: 'illatio' | 'labs' | 'cloud' | 'guild';
}
const { variant = 'illatio' } = Astro.props;
const isGuild = variant === 'guild';
const color = isGuild
  ? '#d2e89e'
  : variant === 'labs'
    ? '#6c4b96'
    : variant === 'cloud'
      ? '#2c5b8c'
      : '#b84426';
const warmGlow = isGuild ? '#ebac62' : '#e08b44';
const muted = isGuild ? '#5b7165' : '#9aa495';

const pt = (col: number, row: number) => {
  const x = Number((26 + col * 25).toFixed(1));
  const y = Number((148 + row * 14 - Math.sin((col / 21) * Math.PI) * (82 - row * 3.8)).toFixed(1));
  return { x, y };
};

const activePathCoords: Array<[number, number]> = [
  [6, 4],
  [6, 5],
  [6, 6],
  [6, 7],
  [6, 8],
  [7, 8],
  [8, 8],
  [9, 8],
  [10, 8],
  [11, 8],
  [12, 8],
  [13, 8],
  [14, 8],
  [15, 8],
  [15, 9],
  [15, 10],
  [15, 11],
  [15, 12],
];

const activeKeySet = new Set(activePathCoords.map(([c, r]) => `${c},${r}`));
const activePoints = activePathCoords.map(([c, r]) => pt(c, r));
const routeD = activePoints.map((p, i) => `${i === 0 ? 'M' : 'L'} ${p.x} ${p.y}`).join(' ');
const startPt = activePoints[0];
const midPt = activePoints[4];
const turnPt = activePoints[13];
const endPt = activePoints[activePoints.length - 1];
---

<div class="hero-art" data-field-card>
  <svg class="field" viewBox="0 0 600 540" role="img" aria-labelledby={`field-title-${variant}`}>
    <title id={`field-title-${variant}`}>
      An abstract field of connected points, with a small active path and warm traveling token
      pulses through a larger network.
    </title>
    <defs>
      <radialGradient id={`fade-${variant}`} cx="52%" cy="46%" r="50%">
        <stop offset="0%" stop-color={color} stop-opacity=".22"></stop>
        <stop offset="52%" stop-color={warmGlow} stop-opacity=".10"></stop>
        <stop offset="100%" stop-color={color} stop-opacity="0"></stop>
      </radialGradient>
      <filter id={`glow-${variant}`} x="-30%" y="-30%" width="160%" height="160%">
        <feGaussianBlur stdDeviation="3.5" result="blur"></feGaussianBlur>
        <feMerge>
          <feMergeNode in="blur"></feMergeNode>
          <feMergeNode in="SourceGraphic"></feMergeNode>
        </feMerge>
      </filter>
    </defs>

    <!-- Warm ambient hearth halo behind the lattice -->
    <circle cx="305" cy="245" r="245" fill={`url(#fade-${variant})`}></circle>

    <!-- Horizontal & vertical curved manifold lines -->
    <g class="lattice-lines">
      {
        Array.from({ length: 16 }, (_, row) => {
          const rowPts = Array.from({ length: 22 }, (__, col) => pt(col, row));
          const d = rowPts.map((p, i) => `${i === 0 ? 'M' : 'L'} ${p.x} ${p.y}`).join(' ');
          return <path d={d} fill="none" stroke={muted} stroke-width=".65" opacity=".28" />;
        })
      }
      {
        Array.from({ length: 22 }, (_, col) => {
          const colPts = Array.from({ length: 16 }, (__, row) => pt(col, row));
          const d = colPts.map((p, i) => `${i === 0 ? 'M' : 'L'} ${p.x} ${p.y}`).join(' ');
          return <path d={d} fill="none" stroke={muted} stroke-width=".65" opacity=".28" />;
        })
      }
    </g>

    <!-- Inactive lattice nodes -->
    <g>
      {
        Array.from({ length: 16 }, (_, row) =>
          Array.from({ length: 22 }, (__, col) => {
            if (activeKeySet.has(`${col},${row}`)) return null;
            const p = pt(col, row);
            return <circle cx={p.x} cy={p.y} r="1.35" fill={muted} opacity=".42" />;
          }),
        )
      }
    </g>

    <!-- Active route base & animated glowing token stream -->
    <path
      d={routeD}
      fill="none"
      stroke={color}
      stroke-width="3.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      opacity=".18"></path>
    <path
      class="route"
      d={routeD}
      fill="none"
      stroke={color}
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
    <path
      class="route-glow"
      d={routeD}
      fill="none"
      stroke={warmGlow}
      stroke-width="3.2"
      stroke-linecap="round"
      stroke-linejoin="round"
      filter={`url(#glow-${variant})`}></path>

    <!-- Active route nodes (exact coordinates on routeD) -->
    <g>
      {
        activePoints.map((p, idx) => (
          <circle
            class="signal"
            cx={p.x}
            cy={p.y}
            r={idx === 0 || idx === activePoints.length - 1 ? 4.6 : 3.4}
            fill={idx % 3 === 0 ? warmGlow : color}
            style={`--delay:${(idx * 0.14).toFixed(2)}s`}
          />
        ))
      }
    </g>

    <!-- Concentric anchor rings centered on exact start, corner, and end points -->
    <circle
      class="node-halo"
      cx={startPt.x}
      cy={startPt.y}
      r="13"
      fill="none"
      stroke={color}
      stroke-width="1.1"></circle>
    <circle
      cx={startPt.x}
      cy={startPt.y}
      r="19"
      fill="none"
      stroke={color}
      stroke-width=".7"
      stroke-dasharray="3 3"
      opacity=".45"></circle>

    <circle
      cx={midPt.x}
      cy={midPt.y}
      r="8"
      fill="none"
      stroke={warmGlow}
      stroke-width=".9"
      opacity=".5"></circle>
    <circle
      cx={turnPt.x}
      cy={turnPt.y}
      r="8"
      fill="none"
      stroke={warmGlow}
      stroke-width=".9"
      opacity=".5"></circle>

    <circle
      class="node-halo"
      cx={endPt.x}
      cy={endPt.y}
      r="13"
      fill="none"
      stroke={color}
      stroke-width="1.1"></circle>
    <circle
      cx={endPt.x}
      cy={endPt.y}
      r="19"
      fill="none"
      stroke={color}
      stroke-width=".7"
      stroke-dasharray="3 3"
      opacity=".45"></circle>

    <!-- Editorial annotations -->
    <g
      fill={isGuild ? '#b6c2b8' : '#576058'}
      font-family="monospace"
      font-size="10"
      letter-spacing="1"
    >
      <text x="28" y="54">
        {
          variant === 'labs'
            ? 'RESEARCH STUDY / OPEN QUESTIONS'
            : variant === 'cloud'
              ? 'LOCAL DESK → HOSTED / IN DEVELOPMENT'
              : 'SPARSE WORKSHOP / ACTIVE PATH'
        }
      </text>
      <text x={startPt.x - 18} y={startPt.y - 24} font-size="9" opacity=".8"> PROMPT TOKEN </text>
      <text x={endPt.x - 42} y={endPt.y + 32} font-size="9" opacity=".8"> COMMITTED OUTPUT </text>
      <text x="28" y="462">FEWER ACTIVE WEIGHTS.</text>
      <text x="28" y="480">MORE POSSIBILITIES.</text>
      <text x="424" y="480">FIG. 01 · LIVING STUDY</text>
    </g>
    <path d="M28 500h544" stroke={muted} stroke-width=".55"></path>
    <path d="M28 490v20m544-20v20" stroke={muted}></path>
  </svg>
  <div class="art-caption">
    <span>A warm study in sparse computation</span>
    <button type="button" class="pulse-trigger" data-pulse-btn>
      <span class="dot" aria-hidden="true"></span> Send a token pulse
    </button>
    <span>Conceptual illustration / not telemetry</span>
  </div>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-field-card]').forEach((card) => {
    const btn = card.querySelector<HTMLButtonElement>('[data-pulse-btn]');
    btn?.addEventListener('click', () => {
      card.classList.remove('is-pulsing');
      void card.offsetWidth;
      card.classList.add('is-pulsing');
      setTimeout(() => card.classList.remove('is-pulsing'), 1800);
    });
  });
</script>
