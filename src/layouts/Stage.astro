---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/archivo/wdth-italic.css';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../vendor/scrollcraft/scrollcraft.css';
import '../styles/base.css';
import GlobalNav from '../components/GlobalNav.astro';
import GlobalFooter from '../components/GlobalFooter.astro';
import { asset, canonical, type Property } from '../lib/links';
interface Props {
  title: string;
  description: string;
  property?: Property;
  path?: string;
  theme: string;
  tone?: 'dark' | 'light';
  current?: 'project' | 'engine' | 'docs' | 'models' | 'labs';
  noindex?: boolean;
}
const {
  title,
  description,
  property = 'illatio',
  path = '',
  theme,
  tone = 'dark',
  current,
  noindex = false,
} = Astro.props;
const preview = import.meta.env.PUBLIC_DEPLOYMENT !== 'production';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content={theme} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical(property, path)} />
    {(preview || noindex) && <meta name="robots" content="noindex,follow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical(property, path)} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={canonical(property, 'social.svg')} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <noscript>
      <style is:inline>
        /* Without JavaScript every scroll cue is simply shown, and stacked crossfades become a list. */
        [data-sc-cue],
        [data-sc-in],
        [data-sc-stagger] > * {
          opacity: 1 !important;
          transform: none !important;
        }
        [data-noscript-unstack] > * {
          grid-area: auto !important;
        }
        [data-noscript-hide] {
          display: none !important;
        }
        [data-sc-stage] {
          position: relative;
          overflow: clip;
        }
      </style>
    </noscript>
  </head>
  <body class={`site site-${property} theme-${tone}`}>
    <a class="skip" href="#main">Skip to content</a>
    <div class="sc-grain" aria-hidden="true"></div>
    <GlobalNav {current} />
    <slot />
    <GlobalFooter />
    <script>
      import { engine } from '../scripts/engine';
      engine.mount(document.body);
    </script>
  </body>
</html>
