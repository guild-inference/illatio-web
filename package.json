{
  "name": "illatio-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4173",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4173",
    "typecheck": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "package:site": "node scripts/package-site.mjs",
    "check:worker": "wrangler deploy --dry-run",
    "deploy:worker": "PUBLIC_DEPLOYMENT=production npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.2.0",
    "@fontsource/instrument-serif": "^5.2.0",
    "astro": "^5.16.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.0",
    "eslint-plugin-astro": "^1.5.0",
    "prettier": "^3.6.0",
    "prettier-plugin-astro": "^0.14.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0"
  }
}
